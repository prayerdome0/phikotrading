# ─────────────────────────────────────────────────────────────────────────────
# PHIKO TRADING — environment configuration (TEMPLATE)
# Copy this file to `.env` and fill in real values on your own machine only.
# `.env` is git-ignored — API secrets must NEVER be committed to GitHub,
# shipped to the browser, or embedded in frontend source code.
# ─────────────────────────────────────────────────────────────────────────────

# Server-side only (Node tooling, media administration, signed operations).
# The PUBLIC website itself never reads this variable.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dhad95cch

# Public, non-secret delivery/upload settings (safe to expose in the browser)
CLOUDINARY_CLOUD_NAME=dhad95cch
CLOUDINARY_UPLOAD_PRESET=phikotrading   # Signing mode: Unsigned
CLOUDINARY_ASSET_FOLDER=                # "No folders" — uploads stay at root

# Booking calendar — the calendar name will be provided by the owner.
# Once provided, set it here (and in js/config.js PUBLIC_CALENDAR_NAME).
PUBLIC_CALENDAR_NAME=
